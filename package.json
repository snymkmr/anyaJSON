{
	"name": "anyajson",
	"displayName": "AnyaJSON",
	"description": "Format, minify, and lint JSON in VS Code.",
	"version": "0.3.0",
	"publisher": "Sanyam",
	"repository": {
		"type": "git",
		"url": "https://github.com/snymkmr/anyaJSON.git"
	},
	"icon": "JSON-icon.png",
	"license": "MIT",
	"engines": {
		"vscode": "^1.90.0"
	},
	"categories": [
		"Formatters",
		"Linters"
	],
	"activationEvents": [
		"onLanguage:json",
		"onCommand:anyajson.formatJson",
		"onCommand:anyajson.minifyJson",
		"onCommand:anyajson.lintJson",
		"onCommand:anyajson.previewJsonAsTable"
	],
	"main": "./extension.js",
	"scripts": {
		"test": "node --test",
		"package": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && vsce package -o dist/"
	},
	"contributes": {
		"commands": [
			{
				"command": "anyajson.formatJson",
				"title": "AnyaJSON: Format JSON Document"
			},
			{
				"command": "anyajson.minifyJson",
				"title": "AnyaJSON: Minify JSON Document"
			},
			{
				"command": "anyajson.lintJson",
				"title": "AnyaJSON: Lint JSON Document"
			},
			{
				"command": "anyajson.previewJsonAsTable",
				"title": "AnyaJSON: Preview JSON as Table",
				"icon": "$(table)"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "anyajson.previewJsonAsTable",
					"when": "editorLangId == json || resourceExtname == .json",
					"group": "navigation"
				}
			],
			"editor/context": [
				{
					"command": "anyajson.formatJson",
					"when": "editorLangId == json || resourceExtname == .json",
					"group": "1_modification@1"
				},
				{
					"command": "anyajson.minifyJson",
					"when": "editorLangId == json || resourceExtname == .json",
					"group": "1_modification@2"
				},
				{
					"command": "anyajson.lintJson",
					"when": "editorLangId == json || resourceExtname == .json",
					"group": "1_modification@3"
				},
				{
					"command": "anyajson.previewJsonAsTable",
					"when": "editorLangId == json || resourceExtname == .json",
					"group": "1_modification@4"
				}
			],
			"explorer/context": [
				{
					"command": "anyajson.formatJson",
					"when": "resourceExtname == .json",
					"group": "2_workspace@1"
				},
				{
					"command": "anyajson.minifyJson",
					"when": "resourceExtname == .json",
					"group": "2_workspace@2"
				},
				{
					"command": "anyajson.lintJson",
					"when": "resourceExtname == .json",
					"group": "2_workspace@3"
				},
				{
					"command": "anyajson.previewJsonAsTable",
					"when": "resourceExtname == .json",
					"group": "2_workspace@4"
				}
			]
		},
		"configuration": {
			"title": "AnyaJSON",
			"properties": {
				"anyajson.indent": {
					"type": "string",
					"enum": [
						"tab",
						"2",
						"4",
						"editor"
					],
					"enumDescriptions": [
						"Indent each level with one tab.",
						"Indent each level with 2 spaces.",
						"Indent each level with 4 spaces.",
						"Use the file's editor indentation (Editor: Insert Spaces and Editor: Tab Size, including auto-detected values)."
					],
					"default": "tab",
					"description": "Indentation used by AnyaJSON: Format JSON Document and Format Document."
				},
				"anyajson.lintOnChange": {
					"type": "boolean",
					"default": true,
					"description": "Lint JSON after edits. Linting is debounced; disable this for very large documents if it slows editing."
				},
				"anyajson.lintOnSave": {
					"type": "boolean",
					"default": true,
					"description": "Lint JSON when a document is saved."
				}
			}
		}
	},
	"devDependencies": {
		"@vscode/vsce": "^4.1.0"
	}
}
